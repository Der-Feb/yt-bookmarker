{
  "name": "Youtube bookmarker",
  "version": "0.1.0",
  "description": "An extension to bookmark YouTube videos and manage them easily.",
  "manifest_version": 3,

  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://*.youtube.com/*"],

  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["content.js"]
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "public/bookmark.png",
        "public/play.png",
        "public/delete.png",
        "public/save.png"
      ],
      "matches": ["https://*.youtube.com/*"]
    }
  ],

  "action": {
    "default_icon": {
      "16": "public/ext-icon.png",
      "24": "public/ext-icon.png",
      "32": "public/ext-icon.png"
    },
    "default_title": "YT Bookmarker",
    "default_popup": "popup.html"
  }
}
